---
// "Check your inbox" after sign-up. The same screen for a new and an existing address, so the form never reveals
// that an account exists; the last line sends someone who already has an account to password recovery.
import AuthSpreadLayout from "@/layouts/AuthSpreadLayout.astro";
import { AUTH_COPY } from "@/lib/copy/auth";

const copy = AUTH_COPY.checkInbox;
---

<AuthSpreadLayout title={copy.pageTitle}>
  <h1 class="mb-4 text-2xl font-bold">{copy.heading}</h1>
  <p class="mb-4">{copy.body}</p>
  <p class="mb-4">{copy.noMail}</p>
  <p class="mb-6">
    {copy.existingBefore}
    <a href="/auth/forgot-password" class="text-primary underline underline-offset-4 hover:no-underline">
      {copy.existingLink}
    </a>
    {copy.existingAfter}
  </p>
  <a href="/auth/signin" class="text-primary underline underline-offset-4 hover:no-underline">
    {copy.backToSignIn}
  </a>
</AuthSpreadLayout>
