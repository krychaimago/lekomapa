---
import Layout from "@/layouts/Layout.astro";
import AuthCard from "@/components/auth/AuthCard.astro";
import ResetPasswordForm from "@/components/auth/ResetPasswordForm";
import { buttonVariants } from "@/components/ui/button";
import { PASSWORD_RECOVERY_COPY, apiErrorMessage } from "@/lib/copy/password-recovery";
import { cn } from "@/lib/utils";

// Reachable only in a session opened from a reset link (middleware redirects every other session).
// Recovery session page: keep it out of caches and Referer headers.
Astro.response.headers.set("Cache-Control", "no-store");
// same-origin, not no-referrer: under no-referrer the browser posts the form with `Origin: null`, which
// Astro's checkOrigin rejects with 403. same-origin still sends nothing to any other site.
Astro.response.headers.set("Referrer-Policy", "same-origin");
const copy = PASSWORD_RECOVERY_COPY.resetPassword;
const error = apiErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title={copy.title}>
  <AuthCard title={copy.title}>
    <p class="mb-6 text-muted-foreground">{copy.intro}</p>
    <ResetPasswordForm serverError={error} client:load />
    {/* The only way out of recovery mode for someone who remembered the old password. */}
    <form method="POST" action="/api/auth/signout" class="mt-4">
      <button type="submit" class:list={cn(buttonVariants({ variant: "outline" }), "w-full rounded-lg text-base")}>
        {copy.cancel}
      </button>
    </form>
  </AuthCard>
</Layout>
