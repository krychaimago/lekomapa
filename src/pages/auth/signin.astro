---
import AuthSpreadLayout from "@/layouts/AuthSpreadLayout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { AUTH_COPY, authErrorMessage } from "@/lib/copy/auth";
import { PASSWORD_RECOVERY_COPY } from "@/lib/copy/password-recovery";

const copy = AUTH_COPY.signIn;
// Only a known code from the sign-in route shows text; anything else in `?error=` shows nothing.
const error = authErrorMessage(Astro.url.searchParams.get("error"));
const resetDone = Astro.url.searchParams.get("reset") === "done";
---

<AuthSpreadLayout title={copy.pageTitle}>
  <h1 class="mb-6 text-2xl font-bold">{copy.heading}</h1>
  {resetDone && (
    <p role="status" class="mb-4 rounded-lg border border-accent-border bg-accent px-3 py-2 text-accent-foreground">
      {PASSWORD_RECOVERY_COPY.signIn.resetDone}
    </p>
  )}
  <SignInForm serverError={error} client:load />
  <p class="mt-6">
    <a href="/auth/forgot-password" class="text-primary underline underline-offset-4 hover:no-underline">
      {PASSWORD_RECOVERY_COPY.signIn.forgotPasswordLink}
    </a>
  </p>
  <p class="mt-3">
    {copy.signUpPrompt}{" "}
    <a href="/auth/signup" class="text-primary underline underline-offset-4 hover:no-underline">
      {copy.signUpLink}
    </a>
  </p>
</AuthSpreadLayout>
