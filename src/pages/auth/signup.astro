---
import AuthSpreadLayout from "@/layouts/AuthSpreadLayout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { AUTH_COPY, authErrorMessage } from "@/lib/copy/auth";

const copy = AUTH_COPY.signUp;
// Only a known code from the sign-up route shows text; anything else in `?error=` shows nothing.
const error = authErrorMessage(Astro.url.searchParams.get("error"));
---

<AuthSpreadLayout title={copy.pageTitle}>
  <h1 class="mb-2 text-2xl font-bold">{copy.heading}</h1>
  <p class="mb-6">{copy.intro}</p>
  <SignUpForm serverError={error} client:load />
  <p class="mt-6">
    {copy.signInPrompt}{" "}
    <a href="/auth/signin" class="text-primary underline underline-offset-4 hover:no-underline">
      {copy.signInLink}
    </a>
  </p>
</AuthSpreadLayout>
