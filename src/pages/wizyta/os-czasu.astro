---
// Medication and symptom timeline (S-09, FR-013), opened from "Wizyta" and "Dziennik": dosage periods of every
// medication on one date axis and the entries of one symptom the person picks herself (none at the start). The page
// only loads the account's data (RLS) and computes the model; the body is TimelineView, so the render can be measured
// without Supabase (scripts/timeline/render-bench.mjs).
//
// The timeline shows dates, not relations: it never says a medication causes a symptom, never suggests stopping or
// changing a dose, never orders medications by suspicion — only by the start of the first period, then name — and
// never links a symptom to a medication in the picture (FR-012). The filters are CSS on the page, with no URL
// parameters: no medication name, substance, dose or symptom reaches the address or the title, which is fixed text.
import AppLayout from "@/layouts/AppLayout.astro";
import TimelineView from "@/components/timeline/TimelineView.astro";
import { TIMELINE_COPY as copy } from "@/lib/copy/timeline";
import { todayInWarsaw } from "@/lib/services/medications";
import { buildTimeline } from "@/lib/services/timeline";
import { loadTimelineData } from "@/lib/services/timeline-data";
import { createClient } from "@/lib/supabase";

const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase ? await loadTimelineData(supabase) : ({ error: true } as const);
const model = "error" in result ? null : buildTimeline({ ...result, today: todayInWarsaw() });
if (!model) Astro.response.status = 500;
---

<AppLayout title={copy.title}>
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <div class="flex flex-col gap-2">
      <h1 class="text-3xl font-bold">{copy.title}</h1>
      <p class="text-muted-foreground">{copy.intro}</p>
    </div>

    {model ? (
      <TimelineView model={model} />
    ) : (
      <p
        role="alert"
        class="rounded-lg border border-destructive-border bg-destructive-surface px-4 py-3 text-destructive"
      >
        {copy.loadError}
      </p>
    )}
  </div>
</AppLayout>
