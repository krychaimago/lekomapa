---
// Adding a medication from outside the registry (S-02, FR-003): a free product name and one active substance from
// the leaflet, suggested from the dictionary of substances that have an ATC code. No medication or substance name
// travels in the address (lesson "Żadna nazwa leku ani dawka w adresie URL"); the page reads only:
//   ?error=  a code from the save route, looked up in MEDICATION_COPY.apiErrors.
// The typed product name, substance and date come from the leaflet draft cookie (HttpOnly, short-lived, this account
// only), written by POST /api/medications after a failed save and by POST /api/medications/draft. The dose is never
// put back. A draft with `unmatched: true` is the "no match" state: the typed substance is not in the dictionary, so
// the page lists similar names and offers "save without checking" (the only way to save it without a code). Each
// similar name is a button in its own POST form to the draft route, which puts that name into the substance field.
import AppLayout from "@/layouts/AppLayout.astro";
import AddLeafletMedicationForm from "@/components/medications/AddLeafletMedicationForm";
import { MEDICATION_COPY, apiErrorMessage } from "@/lib/copy/medications";
import { readLeafletDraft } from "@/lib/medication-draft";
import { similarSubstances, todayInWarsaw } from "@/lib/services/medications";
import { createClient } from "@/lib/supabase";
import { reportError } from "@/lib/observability/report";

const copy = MEDICATION_COPY.leaflet;
const error = apiErrorMessage(Astro.url.searchParams.get("error"));
// The page is protected, so a user is always signed in here; the draft is read only for that account.
const userId = Astro.locals.user?.id ?? "";
const draft = readLeafletDraft(Astro.cookies, userId);
const productName = draft?.productName ?? "";
const substanceName = draft?.substanceName ?? "";
const unmatched = draft?.unmatched && substanceName ? substanceName : "";
const today = todayInWarsaw();
// The draft holds only real ISO dates; a date from the future falls back to today, as the form does not accept it.
const startedOn = draft?.startedOn && draft.startedOn <= today ? draft.startedOn : today;

// Distinct dictionary names with a code, alphabetically, in one call. The function returns a single array, so the
// PostgREST row cap (max_rows) cannot drop names.
let substanceNames: string[] = [];
let loadFailed: boolean;
const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  const response = await supabase.rpc("coded_substance_names");
  if (response.error) reportError("registry.read-substances", { code: response.error.code, route: Astro.routePattern });
  const names: unknown = response.error ? null : response.data;
  // A missing or empty dictionary would hide names and push the user towards saving without a code: fail visibly.
  const isNameList = (value: unknown): value is string[] =>
    Array.isArray(value) && value.length > 0 && value.every((name) => typeof name === "string");
  loadFailed = !isNameList(names);
  if (isNameList(names)) substanceNames = names;
} else {
  loadFailed = true;
}

const showNoMatch = unmatched !== "";
const similar = showNoMatch ? similarSubstances(unmatched, substanceNames) : [];
const linkClass = "text-primary underline underline-offset-4 hover:no-underline";
---

<AppLayout title={copy.title}>
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-bold">{copy.title}</h1>
      <a href="/leki" class:list={linkClass}>
        {MEDICATION_COPY.add.backToList}
      </a>
    </div>

    {loadFailed && (
      <p
        role="alert"
        class="rounded-lg border border-destructive-border bg-destructive-surface px-4 py-3 text-destructive"
      >
        {copy.loadError}
      </p>
    )}

    {showNoMatch && !loadFailed && (
      <section
        role="status"
        class="flex flex-col gap-3 rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm"
      >
        <p>{copy.noMatch}</p>
        {similar.length > 0 ? (
          <ul class="flex flex-col gap-2">
            {similar.map((name) => (
              <li>
                <form method="post" action="/api/medications/draft">
                  <input type="hidden" name="kind" value="leaflet" />
                  <input type="hidden" name="productName" value={productName} />
                  <input type="hidden" name="startedOn" value={startedOn} />
                  <input type="hidden" name="substanceName" value={name} />
                  <button
                    type="submit"
                    class="flex min-h-12 w-full items-center rounded-lg border border-border bg-card px-4 py-2 text-left font-medium text-card-foreground hover:border-primary"
                  >
                    {name}
                  </button>
                </form>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-sm text-muted-foreground">{copy.noSimilar}</p>
        )}
      </section>
    )}

    {!loadFailed && (
      <AddLeafletMedicationForm
        substanceNames={substanceNames}
        productName={productName}
        substanceName={substanceName}
        startedOn={startedOn}
        today={today}
        showConfirmUnverified={showNoMatch}
        serverError={error}
        client:load
      />
    )}

    <div class="grid gap-4 sm:grid-cols-2">
      <section class="rounded-lg border border-border bg-card p-4 text-card-foreground">
        <h2 class="mb-1 font-semibold">{MEDICATION_COPY.hints.doseHistoryTitle}</h2>
        <p class="text-sm text-muted-foreground">{MEDICATION_COPY.hints.doseHistory}</p>
      </section>
      <section class="rounded-lg border border-border bg-card p-4 text-card-foreground">
        <h2 class="mb-1 font-semibold">{MEDICATION_COPY.hints.fixedCompositionTitle}</h2>
        <p class="text-sm text-muted-foreground">{MEDICATION_COPY.hints.fixedComposition}</p>
      </section>
    </div>

    <a href="/leki/nowy" class:list={linkClass}>
      {copy.registryInstead}
    </a>
  </div>
</AppLayout>
