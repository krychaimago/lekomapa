---
// List of current medications (S-02). Newest start date first; a medication in a checked pair carries the amber
// flag, which never changes the order (FR-012). The note and the "no flag is not safe" sentence stay under the list
// whatever it holds. Under them the interaction graph (S-10, FR-014, section #graf), which shows current medications
// only, so it sits above the link to ended ones (/leki/zakonczone, with their number). The graph is built by
// buildInteractionGraph from the same current medications and interaction rows as the list, plus a light read of the
// account's medication history (id and the two timestamps) that keeps each point's place stable. A failed history read
// replaces only the graph with an error text; the list keeps working.
import AppLayout from "@/layouts/AppLayout.astro";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import InteractionGraph from "@/components/medications/InteractionGraph";
import { INTERACTION_COPY } from "@/lib/copy/interactions";
import { MEDICATION_COPY } from "@/lib/copy/medications";
import { formatCorrectionDeadline } from "@/lib/services/journal";
import { buildInteractionGraph } from "@/lib/services/interaction-graph";
import { formatIsoDate, orderMedications, todayInWarsaw } from "@/lib/services/medications";
import { createClient } from "@/lib/supabase";
import { reportError } from "@/lib/observability/report";
import { cn } from "@/lib/utils";
import type { DosagePeriod, InteractionGraphModel, Medication, MedicationInteraction } from "@/types";

type MedicationRow = Pick<Medication, "id" | "product_name" | "created_at"> & {
  // End of the medication's correction window (S-05), read from the database so the banner agrees with the guard.
  correction_window_ends_at: string | null;
  // Each period carries its own window end: a dose change opens a new window on a medication added long ago.
  dosage_periods: (Pick<DosagePeriod, "started_on"> & { correction_window_ends_at: string | null })[];
};

// One row of the account's medication history for the graph; `discontinued_at` is stamped by the database.
interface HistoryRow {
  id: string;
  created_at: string;
  discontinued_at: string | null;
}

const copy = MEDICATION_COPY.list;
const addedId = Astro.url.searchParams.get("dodano");
// Banner after deleting an item added by mistake; the flag carries no data.
const deleted = Astro.url.searchParams.get("usunieto") === "1";

let loadFailed = false;
let rows: MedicationRow[] = [];
let flagged = new Set<string>();
// Number of ended medications for the link under the note; null when unknown, and then the link is not shown.
let endedCount: number | null = null;
let interactionRows: MedicationInteraction[] = [];
// History for the graph; null when its read failed, and then the graph shows its error text instead.
let history: HistoryRow[] | null = null;
let today = "";

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  today = todayInWarsaw();
  // Same "current" rule as medication_interactions(): not discontinued, or discontinued after today (Polish time).
  // RLS limits both reads to the signed-in person.
  // The ended count is a separate head-only query: its failure hides the link and never breaks the list.
  // The graph history reads every medication of the account, ended ones included (RLS), only ids and timestamps.
  const [medications, interactions, ended, graphHistory] = await Promise.all([
    supabase
      .from("medications")
      .select(
        "id, product_name, created_at, correction_window_ends_at, dosage_periods(started_on, correction_window_ends_at)",
      )
      .or(`discontinued_on.is.null,discontinued_on.gt.${today}`)
      .overrideTypes<MedicationRow[], { merge: false }>(),
    supabase.rpc("medication_interactions"),
    supabase.from("medications").select("id", { count: "exact", head: true }).not("discontinued_on", "is", null),
    supabase
      .from("medications")
      .select("id, created_at, discontinued_at")
      .overrideTypes<HistoryRow[], { merge: false }>(),
  ]);
  if (graphHistory.error) {
    reportError("medications.graph-history", { code: graphHistory.error.code, route: Astro.routePattern });
  } else {
    history = graphHistory.data;
  }
  if (ended.error) {
    reportError("medications.count-ended", { code: ended.error.code, route: Astro.routePattern });
  } else {
    endedCount = ended.count;
  }
  if (medications.error || interactions.error) {
    loadFailed = true;
    if (medications.error) {
      reportError("medications.list-load", { code: medications.error.code, route: Astro.routePattern });
    }
    if (interactions.error) {
      reportError("medications.list-interactions", { code: interactions.error.code, route: Astro.routePattern });
    }
  } else {
    rows = medications.data;
    // Untyped client: the setof result is typed as a single row, so the rows are cast here.
    interactionRows = (interactions.data ?? []) as MedicationInteraction[];
    flagged = new Set(interactionRows.map((row) => row.medication_id));
  }
} else {
  loadFailed = true;
}

const nowIso = new Date().toISOString();

// Latest still-open correction window among the medication's dosage periods, compared with the server's clock;
// null when none is open.
function openPeriodDeadline(row: MedicationRow): string | null {
  const open = row.dosage_periods
    .map((period) => period.correction_window_ends_at)
    .filter((endsAt): endsAt is string => endsAt !== null && Date.parse(endsAt) > Date.parse(nowIso))
    .sort((a, b) => Date.parse(a) - Date.parse(b))
    .at(-1);
  return open === undefined ? null : formatCorrectionDeadline(open, nowIso);
}

// The first dosage period gives the start date shown on the list.
const items = orderMedications(
  rows.map((row) => {
    const firstStart = row.dosage_periods
      .map((period) => period.started_on)
      .sort()
      .at(0);
    return {
      id: row.id,
      name: row.product_name,
      startedOn: firstStart ?? "",
      createdAt: row.created_at,
      flagged: flagged.has(row.id),
      deadline: openPeriodDeadline(row),
    };
  }),
);
// The graph takes the same current medications and interaction rows as the list; null below two medications.
const graphModel: InteractionGraphModel | null =
  history === null
    ? null
    : buildInteractionGraph({
        history: history.map((row) => ({
          id: row.id,
          createdAt: row.created_at,
          discontinuedAt: row.discontinued_at,
        })),
        current: items.map((item) => ({ id: item.id, name: item.name })),
        interactions: interactionRows,
        today,
      });
const addedVisible = addedId !== null && items.some((item) => item.id === addedId);
// "Until when" after adding: the window of the medication (its first period is saved in the same call, so it ends at
// the same moment). Shown only while the window is open, compared with the server's clock.
const addedEndsAt = addedVisible ? (rows.find((row) => row.id === addedId)?.correction_window_ends_at ?? null) : null;
const addedDeadline =
  addedEndsAt !== null && Date.parse(addedEndsAt) > Date.parse(nowIso)
    ? formatCorrectionDeadline(addedEndsAt, nowIso)
    : null;
---

<AppLayout title={copy.title}>
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <div class="flex flex-wrap items-center justify-between gap-4">
      <h1 class="text-3xl font-bold">{copy.title}</h1>
      <a href="/leki/nowy" class:list={buttonVariants()}>
        {copy.add}
      </a>
    </div>

    {deleted && (
      <p role="status" class="rounded-lg border border-accent-border bg-accent px-4 py-3 text-accent-foreground">
        {copy.deleted}
      </p>
    )}

    {addedVisible && (
      <p role="status" class="rounded-lg border border-accent-border bg-accent px-4 py-3 text-accent-foreground">
        {addedDeadline
          ? copy.addedWithDeadline
              .replace("{nazwa}", items.find((item) => item.id === addedId)?.name ?? "")
              .replace("{do}", addedDeadline)
          : copy.added}
      </p>
    )}

    {loadFailed ? (
      <p
        role="alert"
        class="rounded-lg border border-destructive-border bg-destructive-surface px-4 py-3 text-destructive"
      >
        {copy.loadError}
      </p>
    ) : items.length === 0 ? (
      <section class="rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm">
        <p class="mb-4">{copy.empty}</p>
        <a href="/leki/nowy" class:list={buttonVariants()}>
          {copy.add}
        </a>
      </section>
    ) : (
      <ul class="flex flex-col gap-3">
        {items.map((item) => (
          <li data-medication-id={item.id}>
            <a
              href={`/leki/${item.id}`}
              class:list={cn(
                "flex min-h-12 flex-col gap-2 rounded-xl border border-border bg-card p-4 text-card-foreground shadow-sm hover:border-primary sm:flex-row sm:items-center sm:justify-between",
                item.id === addedId && "border-primary ring-2 ring-primary",
              )}
            >
              <span class="flex flex-col gap-1">
                <span class="text-lg font-semibold">{item.name}</span>
                {item.startedOn && (
                  <span class="text-sm text-muted-foreground">
                    {copy.since.replace("{data}", formatIsoDate(item.startedOn))}
                  </span>
                )}
                {item.deadline && (
                  <span class="text-sm text-muted-foreground">
                    {copy.correctableUntil.replace("{do}", item.deadline)}
                  </span>
                )}
              </span>
              {item.flagged && (
                <span class:list={badgeVariants({ variant: "interaction" })}>{INTERACTION_COPY.flagLabel}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}

    <div class="flex flex-col gap-2 text-sm text-muted-foreground">
      <p>{INTERACTION_COPY.note}</p>
      <p>{INTERACTION_COPY.noWarningIsNotSafe}</p>
    </div>

    {!loadFailed && (
      <section id="graf" aria-labelledby="graph-title" class="flex scroll-mt-6 flex-col gap-3">
        <h2 id="graph-title" class="text-xl font-semibold">
          {INTERACTION_COPY.graphTitle}
        </h2>
        {history === null ? (
          <p
            role="alert"
            class="rounded-lg border border-destructive-border bg-destructive-surface px-4 py-3 text-destructive"
          >
            {INTERACTION_COPY.graphLoadError}
          </p>
        ) : graphModel ? (
          <>
            <p class="text-sm text-muted-foreground">{INTERACTION_COPY.graphHint}</p>
            <InteractionGraph client:visible model={graphModel} />
          </>
        ) : (
          <p class="text-sm text-muted-foreground">{INTERACTION_COPY.graphTooFewMedications}</p>
        )}
      </section>
    )}

    {endedCount !== null && endedCount > 0 && (
      <a href="/leki/zakonczone" class="text-primary underline underline-offset-4 hover:no-underline">
        {copy.endedLink.replace("{liczba}", String(endedCount))}
      </a>
    )}
  </div>
</AppLayout>
