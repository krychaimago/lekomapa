---
// Medication details (S-02, FR-006, FR-007): dose, start date, the full composition and every possible interaction
// with another current medication, each with the note. Interactions are ordered alphabetically by the other
// medication's name, never by suspicion (FR-012). RLS limits every read to the signed-in person, so another
// account's medication reads as missing and gets the same 404 as an unknown id.
import { z } from "zod";
import AppLayout from "@/layouts/AppLayout.astro";
import { INTERACTION_COPY } from "@/lib/copy/interactions";
import { MEDICATION_COPY } from "@/lib/copy/medications";
import { buttonVariants } from "@/components/ui/button";
import { formatCorrectionDeadline } from "@/lib/services/journal";
import { formatIsoDate, lastDayOfPeriod, todayInWarsaw } from "@/lib/services/medications";
import { createClient } from "@/lib/supabase";
import type { DosagePeriod, Medication, MedicationInteraction, MedicationSubstance, RegistryProduct } from "@/types";

type VariantRow = Pick<RegistryProduct, "strength" | "pharmaceutical_form">;

type MedicationDetailsRow = Pick<Medication, "id" | "product_name" | "composition_source" | "discontinued_on"> & {
  registry_products: VariantRow | null;
  medication_substances: Pick<MedicationSubstance, "substance_name" | "atc_code">[];
  // Each period carries the variant taken in it (S-03); null for a leaflet medication. correction_window_ends_at is
  // the end of the period's own correction window (S-05), read from the database so the link agrees with the guard.
  dosage_periods: (Pick<DosagePeriod, "id" | "dose_text" | "started_on" | "ended_on"> & {
    registry_products: VariantRow | null;
    correction_window_ends_at: string | null;
  })[];
};

interface SubstanceLine {
  name: string;
  // Every code saved for this name; empty when the substance was saved without a code.
  codes: string[];
}

interface InteractionItem {
  otherId: string;
  otherName: string;
  description: string;
}

const copy = MEDICATION_COPY.details;
const id = Astro.params.id ?? "";

let medication: MedicationDetailsRow | null = null;
let interactions: InteractionItem[] = [];
let loadFailed = false;

// A non-uuid id never reaches the database: it would be a 22P02 error there, here it is simply not found.
const validId = z.uuid().safeParse(id).success;
const supabase = validId ? createClient(Astro.request.headers, Astro.cookies) : null;
if (validId && !supabase) loadFailed = true;

if (supabase) {
  const [medicationResult, interactionResult] = await Promise.all([
    supabase
      .from("medications")
      .select(
        "id, product_name, composition_source, discontinued_on, registry_products(strength, pharmaceutical_form), medication_substances(substance_name, atc_code), dosage_periods(id, dose_text, started_on, ended_on, correction_window_ends_at, registry_products(strength, pharmaceutical_form))",
      )
      .eq("id", id)
      .maybeSingle()
      .overrideTypes<MedicationDetailsRow | null, { merge: false }>(),
    supabase.rpc("medication_interactions"),
  ]);
  if (medicationResult.error || interactionResult.error) {
    loadFailed = true;
    console.error("Loading medication details failed", {
      medicationCode: medicationResult.error?.code,
      interactionsCode: interactionResult.error?.code,
    });
  } else {
    medication = medicationResult.data;
    // Untyped client: the setof result is typed as a single row, so the rows are cast here.
    const rows = ((interactionResult.data ?? []) as MedicationInteraction[]).filter((row) => row.medication_id === id);
    const otherIds = [...new Set(rows.map((row) => row.other_medication_id))];
    if (medication && otherIds.length > 0) {
      const others = await supabase
        .from("medications")
        .select("id, product_name")
        .in("id", otherIds)
        .overrideTypes<Pick<Medication, "id" | "product_name">[], { merge: false }>();
      if (others.error) {
        loadFailed = true;
        console.error("Loading interacting medication names failed", { code: others.error.code });
      } else {
        const names = new Map(others.data.map((row) => [row.id, row.product_name]));
        interactions = rows
          .map((row) => ({
            otherId: row.other_medication_id,
            otherName: names.get(row.other_medication_id) ?? "",
            description: row.description,
          }))
          // Alphabetically by the other medication, then by the text: a stable order that says nothing about risk.
          .sort(
            (a, b) => a.otherName.localeCompare(b.otherName, "pl") || a.description.localeCompare(b.description, "pl"),
          );
      }
    }
  }
}

const notFound = !loadFailed && medication === null;
if (notFound) Astro.response.status = 404;
if (loadFailed) Astro.response.status = 500;

// Start date of the first period; dose of the current (open) period, else of the latest one.
const periods = [...(medication?.dosage_periods ?? [])].sort((a, b) => a.started_on.localeCompare(b.started_on));
const firstStart = periods.at(0)?.started_on;
const currentPeriod = periods.find((period) => period.ended_on === null) ?? periods.at(-1);

// One line per substance name with all its codes (a leaflet substance may carry several, e.g. diclofenacum).
const substanceLines: SubstanceLine[] = [];
for (const row of medication?.medication_substances ?? []) {
  let line = substanceLines.find((existing) => existing.name === row.substance_name);
  if (!line) {
    line = { name: row.substance_name, codes: [] };
    substanceLines.push(line);
  }
  if (row.atc_code !== null) line.codes.push(row.atc_code);
}
substanceLines.sort((a, b) => a.name.localeCompare(b.name, "pl"));
for (const line of substanceLines) line.codes.sort();

const isRegistry = medication?.composition_source === "registry";
const registry = isRegistry ? (medication?.registry_products ?? null) : null;

// "Moc: … · Postać: …" for one registry variant; empty for none.
function variantText(variant: VariantRow | null): string {
  return [
    variant?.strength && `${MEDICATION_COPY.add.strength}: ${variant.strength}`,
    variant?.pharmaceutical_form && `${MEDICATION_COPY.add.form}: ${variant.pharmaceutical_form}`,
  ]
    .filter(Boolean)
    .join(" · ");
}

// The summary shows the variant of the current period; the medication's own variant only for a period without one.
const summaryVariant = isRegistry ? variantText(currentPeriod?.registry_products ?? registry) : "";

// One "now" for the whole page, from the server's clock. A period's correction deadline is shown only while its window
// is open; the same comparison the database makes (now() < correction_window_end(created_at)).
const nowIso = new Date().toISOString();
const deadlineOf = (period: { correction_window_ends_at: string | null } | undefined): string | null =>
  period?.correction_window_ends_at != null && Date.parse(period.correction_window_ends_at) > Date.parse(nowIso)
    ? formatCorrectionDeadline(period.correction_window_ends_at, nowIso)
    : null;

// Every dosage period, newest first. A leaflet medication has no registry variant, so its periods show none.
const history = [...periods].reverse().map((period) => ({
  id: period.id,
  deadline: deadlineOf(period),
  dose: period.dose_text,
  variant: isRegistry ? variantText(period.registry_products) : "",
  dates:
    period.ended_on === null
      ? copy.periodOngoing.replace("{data}", formatIsoDate(period.started_on))
      : copy.periodClosed
          .replace("{od}", formatIsoDate(period.started_on))
          .replace("{do}", formatIsoDate(lastDayOfPeriod(period.ended_on))),
}));

// Same "current" rule as DP001 in change_dosage: not discontinued, or discontinued after today (Polish time).
// Only a current medication offers the dose change.
const isCurrent =
  medication !== null && (medication.discontinued_on === null || medication.discontinued_on > todayInWarsaw());
// Banner after a saved dose change; the flag carries no data. The new period is the ongoing one.
const dosageChanged = Astro.url.searchParams.get("zmieniono") === "1";
const changedDeadline = dosageChanged ? deadlineOf(periods.find((period) => period.ended_on === null)) : null;
// Banner after a saved correction: the corrected period's id (a validated uuid of this medication), never the dose.
const correctedParam = z.uuid().safeParse(Astro.url.searchParams.get("poprawiono"));
const correctedPeriod = correctedParam.success
  ? periods.find((period) => period.id === correctedParam.data)
  : undefined;
const correctedDeadline = deadlineOf(correctedPeriod);

const [withBefore, withAfter] = INTERACTION_COPY.withMedication.split("{nazwa}");
const linkClass = "text-primary underline underline-offset-4 hover:no-underline";
---

<AppLayout title={medication?.product_name ?? copy.title}>
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    <a href="/leki" class:list={linkClass}>
      {copy.backToList}
    </a>

    {loadFailed && (
      <p
        role="alert"
        class="rounded-lg border border-destructive-border bg-destructive-surface px-4 py-3 text-destructive"
      >
        {copy.loadError}
      </p>
    )}

    {notFound && (
      <section class="rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm">
        <h1 class="mb-2 text-2xl font-bold">{copy.title}</h1>
        <p>{copy.notFound}</p>
      </section>
    )}

    {medication && !loadFailed && (
      <>
        {dosageChanged && (
          <p role="status" class="rounded-lg border border-accent-border bg-accent px-4 py-3 text-accent-foreground">
            {changedDeadline
              ? MEDICATION_COPY.dosageChange.savedWithDeadline.replace("{do}", changedDeadline)
              : MEDICATION_COPY.dosageChange.saved}
          </p>
        )}

        {correctedPeriod && (
          <p role="status" class="rounded-lg border border-accent-border bg-accent px-4 py-3 text-accent-foreground">
            {correctedDeadline
              ? MEDICATION_COPY.correction.savedWithDeadline.replace("{do}", correctedDeadline)
              : MEDICATION_COPY.correction.saved}
          </p>
        )}

        <div class="flex flex-wrap items-center justify-between gap-4">
          <h1 class="text-3xl font-bold break-words">{medication.product_name}</h1>
          {isCurrent && (
            <a href={`/leki/${medication.id}/zmiana-dawki`} class:list={buttonVariants({ variant: "outline" })}>
              {MEDICATION_COPY.dosageChange.open}
            </a>
          )}
        </div>

        <section class="flex flex-col gap-3 rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm">
          <dl class="grid gap-3 sm:grid-cols-[auto_1fr] sm:gap-x-6">
            {currentPeriod && (
              <>
                <dt class="text-sm text-muted-foreground">{copy.doseLabel}</dt>
                <dd>{currentPeriod.dose_text}</dd>
              </>
            )}
            {firstStart && (
              <>
                <dt class="text-sm text-muted-foreground">{copy.startedOnLabel}</dt>
                <dd>{formatIsoDate(firstStart)}</dd>
              </>
            )}
            {summaryVariant && (
              <>
                <dt class="text-sm text-muted-foreground">{copy.variant}</dt>
                <dd>{summaryVariant}</dd>
              </>
            )}
          </dl>
        </section>

        {history.length > 0 && (
          <section class="flex flex-col gap-3">
            <h2 class="text-xl font-semibold">{copy.historyHeading}</h2>
            <ol class="flex flex-col gap-2">
              {history.map((item) => (
                <li
                  data-period-id={item.id}
                  class="flex min-w-0 flex-col gap-1 rounded-lg border border-border bg-card px-4 py-3 text-card-foreground"
                >
                  <span class="text-sm text-muted-foreground">{item.dates}</span>
                  <span class="font-medium break-words">{item.dose}</span>
                  {item.variant && <span class="text-sm break-words text-muted-foreground">{item.variant}</span>}
                  {item.deadline && (
                    <a href={`/leki/${medication.id}/okresy/${item.id}/poprawa`} class:list={[linkClass, "text-sm"]}>
                      {copy.correctPeriod.replace("{do}", item.deadline)}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </section>
        )}

        <section class="flex flex-col gap-3">
          <h2 class="text-xl font-semibold">{copy.compositionHeading}</h2>
          <ul class="flex flex-col gap-2">
            {substanceLines.map((line) => (
              <li class="flex flex-col gap-1 rounded-lg border border-border bg-card px-4 py-3 text-card-foreground">
                <span class="font-medium">{line.name}</span>
                {line.codes.length > 0 ? (
                  <span class="text-sm text-muted-foreground">
                    {copy.codeLabel}: {line.codes.join(", ")}
                  </span>
                ) : (
                  <span class="text-sm text-muted-foreground">{INTERACTION_COPY.substanceNotCovered}</span>
                )}
              </li>
            ))}
          </ul>
          <p class="text-sm text-muted-foreground">
            {registry ? MEDICATION_COPY.add.registrySource : copy.leafletSource}
          </p>
        </section>

        {interactions.length > 0 ? (
          <section class="flex flex-col gap-3">
            <h2 class="text-xl font-semibold">{INTERACTION_COPY.detailsHeading}</h2>
            <ul class="flex flex-col gap-3">
              {interactions.map((item) => (
                <li
                  data-other-medication-id={item.otherId}
                  class="flex flex-col gap-2 rounded-xl border border-interaction-border bg-interaction p-4 text-interaction-foreground"
                >
                  <p class="font-semibold">
                    {withBefore}
                    <a href={`/leki/${item.otherId}`} class="underline underline-offset-4 hover:no-underline">
                      {item.otherName}
                    </a>
                    {withAfter}
                  </p>
                  <p>{item.description}</p>
                  <p class="text-sm">{INTERACTION_COPY.note}</p>
                </li>
              ))}
            </ul>
            <p class="text-sm text-muted-foreground">{INTERACTION_COPY.rulesIncomplete}</p>
            <p class="text-sm text-muted-foreground">{INTERACTION_COPY.noWarningIsNotSafe}</p>
          </section>
        ) : (
          <section class="flex flex-col gap-2 rounded-xl border border-border bg-card p-6 text-sm text-card-foreground shadow-sm">
            <p>{INTERACTION_COPY.noInteractionsForMedication}</p>
            <p>{INTERACTION_COPY.noWarningIsNotSafe}</p>
          </section>
        )}
      </>
    )}
  </div>
</AppLayout>
