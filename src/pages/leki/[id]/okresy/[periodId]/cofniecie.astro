---
// Undoing a dose change saved by mistake (S-06): a confirmation screen, then a plain HTML form posting to
// /api/medications/{id}/periods/{periodId}/undo. Offered only for the newest period of a current medication that is not
// its first period, while that period's own correction window is open (24 hours from saving it) — the same rule
// undo_dosage_change and dosage_periods_guard_delete enforce. Otherwise the screen says why and offers no button. Only
// the two ids travel in the URL; the route returns nothing but `?error=<key>`, looked up in
// MEDICATION_COPY.apiErrors. RLS limits every read to the signed-in person, so another account's medication reads as
// missing (404).
import { z } from "zod";
import AppLayout from "@/layouts/AppLayout.astro";
import { buttonVariants } from "@/components/ui/button";
import { MEDICATION_COPY, apiErrorMessage, type MedicationApiErrorCode } from "@/lib/copy/medications";
import { formatCorrectionDeadline } from "@/lib/services/journal";
import { formatIsoDate, lastDayOfPeriod, variantText } from "@/lib/services/medications";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";
import type { DosagePeriod, Medication, RegistryProduct } from "@/types";

type VariantRow = Pick<RegistryProduct, "strength" | "pharmaceutical_form">;

type PeriodRow = Pick<DosagePeriod, "id" | "dose_text" | "started_on" | "ended_on"> & {
  correction_window_ends_at: string | null;
  registry_products: VariantRow | null;
};

type MedicationRow = Pick<Medication, "id" | "product_name" | "composition_source" | "discontinued_on"> & {
  registry_products: VariantRow | null;
  dosage_periods: PeriodRow[];
};

const copy = MEDICATION_COPY.undo;
const id = Astro.params.id ?? "";
const periodId = Astro.params.periodId ?? "";
const error = apiErrorMessage(Astro.url.searchParams.get("error"));

let medication: MedicationRow | null = null;
let loadFailed = false;

// Non-uuid ids never reach the database: they would be a 22P02 error there, here they are simply not found.
const validIds = z.uuid().safeParse(id).success && z.uuid().safeParse(periodId).success;
const supabase = validIds ? createClient(Astro.request.headers, Astro.cookies) : null;
if (validIds && !supabase) loadFailed = true;

if (supabase) {
  const result = await supabase
    .from("medications")
    .select(
      "id, product_name, composition_source, discontinued_on, registry_products(strength, pharmaceutical_form), dosage_periods(id, dose_text, started_on, ended_on, correction_window_ends_at, registry_products(strength, pharmaceutical_form))",
    )
    .eq("id", id)
    .maybeSingle()
    .overrideTypes<MedicationRow | null, { merge: false }>();
  if (result.error) {
    loadFailed = true;
    console.error("Loading a medication for undoing a dose change failed", { code: result.error.code });
  } else {
    medication = result.data;
  }
}

// Oldest first; the period must belong to this medication, a period id from another medication reads as missing.
const periods = [...(medication?.dosage_periods ?? [])].sort((a, b) => a.started_on.localeCompare(b.started_on));
const index = periods.findIndex((row) => row.id === periodId);
const period = index === -1 ? null : periods[index];
const previous = index > 0 ? periods[index - 1] : null;

// One "now" for the whole page, from the server's clock; the same comparison the database makes
// (now() < correction_window_end(created_at)).
const nowIso = new Date().toISOString();
const endsAt = period?.correction_window_ends_at ?? null;
const deadline =
  endsAt !== null && Date.parse(endsAt) > Date.parse(nowIso) ? formatCorrectionDeadline(endsAt, nowIso) : null;

// Why the undo is not possible, in the order undo_dosage_change checks it; null when it is.
let unavailable: MedicationApiErrorCode | null = null;
if (period) {
  if (previous === null) unavailable = "undoFirstPeriod";
  else if (index !== periods.length - 1) unavailable = "undoNotLatest";
  else if (medication?.discontinued_on != null) unavailable = "undoDiscontinued";
  else if (deadline === null) unavailable = "undoWindowClosed";
}
const unavailableText = unavailable ? MEDICATION_COPY.apiErrors[unavailable] : null;

const isRegistry = medication?.composition_source === "registry";
// The dose with the variant when it has one: a change of the strength alone keeps the same dose text. A period saved
// without a variant reads the variant of the medication.
function doseWithVariant(row: PeriodRow): string {
  const variant = isRegistry ? variantText(row.registry_products ?? medication?.registry_products ?? null) : "";
  return variant ? `${row.dose_text} (${variant})` : row.dose_text;
}

function periodDates(row: PeriodRow): string {
  return row.ended_on === null
    ? MEDICATION_COPY.details.periodOngoing.replace("{data}", formatIsoDate(row.started_on))
    : MEDICATION_COPY.details.periodClosed
        .replace("{od}", formatIsoDate(row.started_on))
        .replace("{do}", formatIsoDate(lastDayOfPeriod(row.ended_on)));
}

const explanation =
  period && previous
    ? copy.explanation
        .replace("{data}", formatIsoDate(period.started_on))
        .replace("{nowa}", doseWithVariant(period))
        .replace("{poprzednia}", doseWithVariant(previous))
    : "";

const notFound = !loadFailed && (medication === null || period === null);
if (notFound) Astro.response.status = 404;
if (loadFailed) Astro.response.status = 500;

const detailsHref = `/leki/${id}`;
const formAction = `/api/medications/${id}/periods/${periodId}/undo`;
const linkClass = "text-primary underline underline-offset-4 hover:no-underline";
const noticeClass = "flex flex-col gap-3 rounded-xl border border-border bg-card p-6 text-card-foreground shadow-sm";
---

<AppLayout title={copy.title}>
  <div class="mx-auto flex max-w-3xl flex-col gap-6">
    {validIds && medication ? (
      <a href={detailsHref} class:list={linkClass}>
        {MEDICATION_COPY.dosageChange.backToDetails}
      </a>
    ) : (
      <a href="/leki" class:list={linkClass}>
        {MEDICATION_COPY.details.backToList}
      </a>
    )}

    {loadFailed && (
      <p
        role="alert"
        class="rounded-lg border border-destructive-border bg-destructive-surface px-4 py-3 text-destructive"
      >
        {MEDICATION_COPY.details.loadError}
      </p>
    )}

    {notFound && (
      <section class:list={noticeClass}>
        <h1 class="text-2xl font-bold">{copy.title}</h1>
        <p>{medication === null ? MEDICATION_COPY.details.notFound : copy.notFound}</p>
      </section>
    )}

    {medication && period && !loadFailed && (
      <>
        <div class="flex flex-col gap-1">
          <h1 class="text-3xl font-bold">{copy.title}</h1>
          <p class="text-lg break-words">{medication.product_name}</p>
        </div>

        {error && (
          <p
            role="alert"
            class="rounded-lg border border-destructive-border bg-destructive-surface px-4 py-3 text-destructive"
          >
            {error}
          </p>
        )}

        <section class:list={noticeClass}>
          <dl class="grid gap-3 sm:grid-cols-[auto_1fr] sm:gap-x-6">
            <dt class="text-sm text-muted-foreground">{copy.undoneLabel}</dt>
            <dd class="break-words">
              {periodDates(period)} · {doseWithVariant(period)}
            </dd>
            {previous && (
              <>
                <dt class="text-sm text-muted-foreground">{copy.previousLabel}</dt>
                <dd class="break-words">{doseWithVariant(previous)}</dd>
              </>
            )}
          </dl>
        </section>

        {unavailableText === null && deadline ? (
          <section class:list={noticeClass}>
            <p>{explanation}</p>
            <p>{copy.purpose}</p>
            <p class="text-sm text-muted-foreground">{copy.deadline.replace("{do}", deadline)}</p>
            <form method="POST" action={formAction} class="flex flex-col gap-3 sm:flex-row sm:items-center">
              {/* Outline, not destructive: destructive tokens are for form and technical errors only. */}
              <button
                type="submit"
                class:list={cn(buttonVariants({ variant: "outline" }), "w-full rounded-lg text-base sm:w-auto")}
              >
                {copy.submit}
              </button>
              <a href={detailsHref} class:list={linkClass}>
                {MEDICATION_COPY.dosageChange.backToDetails}
              </a>
            </form>
          </section>
        ) : (
          <section class:list={noticeClass}>
            {/* The error from the route already says the same; the reason is shown only when it adds something. */}
            {unavailableText !== error && <p>{unavailableText}</p>}
            <a href={detailsHref} class:list={linkClass}>
              {MEDICATION_COPY.dosageChange.backToDetails}
            </a>
          </section>
        )}
      </>
    )}
  </div>
</AppLayout>
