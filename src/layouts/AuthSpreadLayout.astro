---
// Frame of the S-01 entry screens: the "spread" from the mockup (context/changes/auth-login-design/design-draft.md,
// "Logowanie na dużym ekranie: Rozkładówka"). Large screens: the left page on the sidebar color with the product
// and the privacy note, the right page on the card with the form. Phones: the colored zone above the white one,
// without the three sentences. The left page uses the sidebar role, so its text outside the notes is
// sidebar-foreground only. Since S-08 (board F of https://claude.ai/artifact/67bdzF6SH5KYRcYrf22QbZ, accepted on
// 18.10.2026) the three sentences sit on paper notes on large screens and the heading sits on a note on phones; the
// text on a note uses the paper's own foreground token. The phone heading and the large-screen heading are two
// elements, one of them always display:none, so a screen reader hears the heading once.
import BrandName from "@/components/BrandName.astro";
import PaperNote from "@/components/PaperNote.astro";
import Layout from "@/layouts/Layout.astro";
import { AUTH_COPY } from "@/lib/copy/auth";

interface Props {
  title: string;
}

const { title } = Astro.props;
const copy = AUTH_COPY.spread;

// One note per sentence, as on board F: card, accent, card; on the accent paper the tape is sidebar-colored, so it
// stays visible.
const POINT_NOTES = [
  { paper: "card", tape: "accent", tilt: "-2", offset: "" },
  { paper: "accent", tape: "sidebar", tilt: "2", offset: "ml-20" },
  { paper: "card", tape: "accent", tilt: "-1", offset: "ml-6" },
] as const;
---

<Layout title={title}>
  <div class="flex flex-col lg:min-h-[calc(100dvh-var(--demo-bar-height))] lg:flex-row">
    <section class="flex flex-col gap-3 border-b border-sidebar-border bg-sidebar px-4 py-6 text-sidebar-foreground lg:w-1/2 lg:gap-8 lg:border-r lg:border-b-0 lg:p-12">
      <BrandName name={copy.productName} class="text-2xl font-bold lg:text-3xl" />
      <PaperNote paper="card" tilt="-2" class="mt-2 w-fit max-w-60 px-3.5 pt-4 pb-3 text-base font-semibold lg:hidden">
        {copy.heading}
      </PaperNote>
      <p class="hidden text-2xl font-semibold lg:block">{copy.heading}</p>
      <ul class="hidden flex-1 flex-col gap-5 pt-2 lg:flex">
        {copy.points.map((point, index) => (
          <li class:list={POINT_NOTES[index].offset}>
            <PaperNote
              paper={POINT_NOTES[index].paper}
              tape={POINT_NOTES[index].tape}
              tilt={POINT_NOTES[index].tilt}
              class="max-w-80 px-5 pt-5 pb-4 text-lg"
            >
              {point}
            </PaperNote>
          </li>
        ))}
      </ul>
      <p>
        {copy.privacyNote}{" "}
        <a href="/prywatnosc" class="underline underline-offset-4 hover:no-underline">
          {copy.privacyLink}
        </a>
      </p>
    </section>

    <!-- The fold: an inset shadow in the sidebar border color along the inner edge of the right page. -->
    <section class="flex flex-1 justify-center bg-card px-4 py-8 text-card-foreground lg:items-center lg:p-12 lg:shadow-[inset_16px_0_16px_-16px_var(--sidebar-border)]">
      <div class="w-full max-w-sm">
        <slot />
      </div>
    </section>
  </div>
</Layout>
