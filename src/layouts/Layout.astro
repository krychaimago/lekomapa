---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import DemoBar from "@/components/DemoBar.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
}

const { title = "lekomapa" } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <DemoBar />
    {missingConfigs.map((cfg) => (
      <Banner>
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
  html {
    height: 100%;
  }
  /* min-height, not height: a body capped at the window height ends the sticky demo bar's range
     there, so on a long page the bar scrolled away after one screen. */
  body {
    min-height: 100%;
  }
</style>
