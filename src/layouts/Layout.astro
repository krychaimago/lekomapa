---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import DemoBar from "@/components/DemoBar.astro";
import { missingConfigs } from "@/lib/config-status";
import { THEME_COOKIE, parseThemePreference } from "@/lib/theme";

interface Props {
  title?: string;
}

const { title = "lekomapa" } = Astro.props;

// The server draws <html> in the chosen mode from the first byte: "dark" gets the class, "light" does not,
// and "system" leaves it to the inline script below, which follows prefers-color-scheme.
const theme = parseThemePreference(Astro.cookies.get(THEME_COOKIE)?.value);
---

<!doctype html>
<html lang="pl" class:list={{ dark: theme === "dark" }} data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    {theme === "system" && <script is:inline>
      (() => {
        const query = window.matchMedia("(prefers-color-scheme: dark)");
        const apply = () => document.documentElement.classList.toggle("dark", query.matches);
        apply();
        query.addEventListener("change", apply);
      })();
    </script>}
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="lekomapa" />
    <title>{title}</title>
  </head>
  <body>
    {/* One sticky block for every top bar: the browser stacks a layout's slotted bar right under the demo bar,
        so nothing needs to know the demo bar's height, which wraps to 2-3 lines on phones. */}
    <div class="sticky top-0 z-50">
      <DemoBar />
      <slot name="sticky-top" />
    </div>
    {missingConfigs.map((cfg) => (
      <Banner>
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <slot />
    <script>
      import { installPolishValidation } from "@/lib/form-validation";

      installPolishValidation(document);
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
  html {
    height: 100%;
  }
  /* min-height, not height: a body capped at the window height ends the sticky top block's range
     there, so on a long page the block scrolled away after one screen. */
  body {
    min-height: 100%;
  }
</style>
