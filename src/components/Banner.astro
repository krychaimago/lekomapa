---
// Error banner (the only variant in use: missing configuration). The error is recognisable
// without color too — callers start the message with "Uwaga:".
---

<div class="banner" role="alert">
  <slot />
</div>

<style>
  .banner {
    padding: 0.75rem 1rem;
    font-size: var(--text-floor); /* readability floor from global.css */
    text-align: center;
    border-bottom: 1px solid var(--destructive-border);
    background: var(--destructive-surface);
    color: var(--destructive);
  }
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
</style>
