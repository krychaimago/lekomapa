---
// Frame of the public reading pages (/warunki, /prywatnosc): one column of text on the card, links at the bottom.
// No data from the database, so the pages render the same signed in or not.
interface Props {
  title: string;
  lead: string;
  links: { href: string; label: string }[];
}

const { title, lead, links } = Astro.props;
---

<main class="min-h-full bg-background px-4 py-8 md:py-12">
  <article class="mx-auto max-w-prose rounded-lg border border-border bg-card px-5 py-6 text-card-foreground md:px-10 md:py-10">
    <h1 class="text-2xl font-semibold md:text-3xl">{title}</h1>
    <p class="mt-2 text-muted-foreground">{lead}</p>
    <slot />
    <nav class="mt-10 flex flex-wrap gap-x-6 gap-y-3 border-t border-border pt-6">
      {links.map(({ href, label }) => (
        <a href={href} class="text-primary underline underline-offset-4 hover:no-underline">
          {label}
        </a>
      ))}
    </nav>
  </article>
</main>
