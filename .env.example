SUPABASE_URL=
SUPABASE_KEY=
SMOKE_EMAIL=
SMOKE_PASSWORD=

# Error reports (Sentry). Leave SENTRY_DSN empty to only log errors.
# SENTRY_ENVIRONMENT=local is the value for a developer machine; production sets nothing (defaults to "production").
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# E2E test user (Playwright) — put these in .env.e2e, not here in .env; local Supabase only
# E2E_USERNAME=
# E2E_PASSWORD=
# E2E_PORT=
